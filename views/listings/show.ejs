<% layout("/layouts/boilerplate") -%>


<script>
    // 1. Pass the token as a string literal
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    
    // 2. Pass the JSON object DIRECTLY without wrapping quotes
    const list = <%- JSON.stringify(list) %>;
</script>

<div class="show-page-container row mt-3">
  <!-- Your exact layout column structure remains unchanged -->
    <div class="show-card col-12 col-sm-10 col-md-8 mx-auto">

     <h3><%= list.title %></h3> 
       <div class="show-img-card">
          <img src="<%= list.image.url %>" alt="image">
       </div>
              
       <div class="show-card-description">
        <p> 
            <p><b>Owned By &nbsp;<i><%= list.owner.username %></i></b></p>
            <%= list.description %> <br>
            ₹ <%= list.price.toLocaleString("en-IN") %> <br>
            <%= list.location %> <br>
            <%= list.country %> <br>
       </p>
       </div>

       <% if(currUser && currUser._id.equals(list.owner._id)){ %>
         <div class="show-actions">
          <form method="get" action="/listings/<%= list._id %>/edit">
            <button type="submit" class="btn btn-danger">Edit</button>
          </form>
  
          <form method="post" action="/listings/<%= list._id %>?_method=DELETE">
            <button type="submit" class="btn btn-danger">Delete</button>
          </form>
       </div>
      <% } %>
         
    <!-- Review Input Section -->
    <% if(currUser) { %>
      <hr />
      <div class="review-container">
        <h4>Leave a Review</h4>
        
        <form class="review-form needs-validation" method="POST" action="/listings/<%= list._id %>/reviews" novalidate>
            <!-- Starability Star Rating Section -->
            <div class="mb-3 mt-3">
                <label class="form-label"><b>Rating</b></label>
                <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
            </div>

            <!-- Comment Textarea Section -->
            <div class="mt-3">
                <label for="comment" class="form-label"><b>Comment</b></label>
                <textarea class="form-control" rows="5" name="review[comment]" id="comment" placeholder="Write your review..." required></textarea>
                <div class="invalid-feedback">
                    Please write a review before submitting.
                </div>
            </div>

            <!-- Submit Button -->
            <button class="mt-3 btn btn-outline-dark" type="submit">Submit</button>
        </form>
      </div>
    <% } %>
       
   <!-- Display Existing Reviews Section (Only if reviews array length is greater than 0) -->
<% if(list.reviews.length > 0) { %>
  <hr />
  <p><b>All Reviews</b></p>

  <div class="row">

    <% for (review of list.reviews) { %>

      <div class="col-12 col-sm-6 col-md-5 mb-3">
        <div class="card h-100">
          <div class="card-body">

            <h5 class="card-title">@<%= review.author.username %></h5>

            <p class="card-text"><%= review.comment %></p>

           
            <p class="starability-result card-text"
               data-rating="<%= review.rating %>"></p>
            
            <!-- Only show the delete button if user matches the author -->
            <% if(currUser && review.author._id.equals(currUser._id)) { %>
              <form method="POST" action="/listings/<%= list._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-dark mb-3">Delete</button>
              </form>
            <% } %>

          </div>
        </div>
      </div>

    <% } %>

  </div>

<% } %>

    <!-- Map Canvas Element Box Frame -->
    <hr />
    <div class="mb-3">
       <h3>Where you'll be</h3>
       <div id="map"></div>
    </div>

  </div>
</div>



<script src="/js/map.js"></script>